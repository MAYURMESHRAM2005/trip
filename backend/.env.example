# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/travelmind

# ─── Auth ─────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-32-chars-min
JWT_REFRESH_SECRET=change-me-32-chars-min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Set to "true" in production (https only)
COOKIE_SECURE=false

# Firebase Authentication (Google sign-in)
# 1. Firebase console → Build → Authentication → Sign-in method → enable Google
# 2. The Admin SDK only has to VERIFY ID tokens, which needs the project ID:
#    set FIREBASE_PROJECT_ID to the Firebase project (must match the frontend's
#    VITE_FIREBASE_PROJECT_ID). This is all a deployed server needs.
# Optional (only for other Admin features): a service account. Either paste the
# whole JSON into FIREBASE_SERVICE_ACCOUNT (raw JSON or base64 of it, so a
# single line survives a dashboard paste), or save the key file and point
# FIREBASE_SERVICE_ACCOUNT_PATH at it. Relative paths resolve against the
# backend root (backend/), e.g. src/config/firebase-admin.json - note that the
# key file is git-ignored, so it will NOT exist on the deployed host.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=

# ─── AI ───────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Groq fallback (used when Gemini fails)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Timeout for AI requests (ms)
GEMINI_TIMEOUT_MS=45000
GROQ_TIMEOUT_MS=60000

# ─── Maps / Places / Weather ──────────────────────────────
GEOAPIFY_API_KEY=
OPENWEATHER_API_KEY=

# ─── Travel providers ─────────────────────────────────────
# Flights — AviationStack free tier (https://aviationstack.com)
AVIATIONSTACK_API_KEY=
# Flights — IGNAV (real prices + booking links, https://ignav.com)
IGNAV_API_KEY=
# Hotels — Amadeus self-service test credentials (https://developers.amadeus.com)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test
# Trains — any compliant provider: the app POSTs {from,to,date,passengers,trainClass} to {TRAIN_API_URL}{TRAIN_API_ENDPOINT}
# (protocol https:// is added automatically; RapidAPI hosts are authenticated with x-rapidapi-key/x-rapidapi-host)
TRAIN_API_URL=
TRAIN_API_KEY=
# For RapidAPI: paste the exact search endpoint from the API docs, e.g. /api/v2/getTrainBetweenStations
TRAIN_API_ENDPOINT=/search
BUS_API_URL=
BUS_API_KEY=
BUS_API_ENDPOINT=/search
UNSPLASH_ACCESS_KEY=

# ─── Enrichment providers (optional, improve data quality) ──
# Viator — real tour/activity entry fees (https://www.viator.com/partner)
VIATOR_API_KEY=
VIATOR_AFFILIATE_ID=
# Zomato — real restaurant ratings and meal costs via RapidAPI
ZOMATO_RAPIDAPI_KEY=
ZOMATO_RAPIDAPI_HOST=zomato4.p.rapidapi.com
# Ticketmaster — real cultural events during trip dates (https://developer.ticketmaster.com)
TICKETMASTER_API_KEY=

# ─── Email (verification / password reset) ────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=TravelMind AI <no-reply@travelmind.app>
